{
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/scene/(.*)", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" },
      { "key": "Access-Control-Allow-Origin", "value": "*" } ] }
  ]
}
